<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified"
           targetNamespace="http://example.com/carwithdetails"
           xmlns:tns="http://example.com/carwithdetails">

    <xs:element name="item" type="tns:CarWithDetailsType"/>

    <xs:complexType name="CarWithDetailsType">
        <xs:sequence>
            <xs:element name="model" type="xs:string" minOccurs="1" maxOccurs="1"/>
            <xs:element name="year" type="xs:int" minOccurs="1" maxOccurs="1"/>
            <xs:element name="price" type="xs:double" minOccurs="1" maxOccurs="1"/>
            <xs:element name="color" type="xs:string" minOccurs="1" maxOccurs="1"/>
            <xs:element name="brand_name" type="xs:string" minOccurs="1" maxOccurs="1"/>
            <xs:element name="first_name" type="xs:string" minOccurs="1" maxOccurs="1"/>
            <xs:element name="last_name" type="xs:string" minOccurs="1" maxOccurs="1"/>
        </xs:sequence>
    </xs:complexType>

</xs:schema>